# powstock — Environment Variables
# Copy to .env and fill in your keys.
# All keys are free. See HUMAN_TASKS.md for sign-up links.

# Database (SQLite, default path)
POWSTOCK_DATABASE_URL=sqlite:///./powstock.db

# Companies House (free, 600 req/5min)
# Sign up: https://developer.company-information.service.gov.uk/
POWSTOCK_COMPANIES_HOUSE_API_KEY=

# Tracefour (free, 60 req/hr)
# Sign up: https://tracefour.com (Settings → API Key)
POWSTOCK_TRACEFOUR_API_KEY=

# Finnhub (free, 60 calls/min)
# Sign up: https://finnhub.io/register
POWSTOCK_FINNHUB_API_KEY=

# IBKR L2 (optional, requires account + market data subscription)
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1

# LLM (optional, for physical-reasoning compiler)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Cloudflare R2 backup (optional)
# POWSTOCK_R2_ACCOUNT_ID=954612afb5a97bb15dddcdc70176813d
# POWSTOCK_R2_ENDPOINT=https://954612afb5a97bb15dddcdc70176813d.r2.cloudflarestorage.com
# POWSTOCK_R2_BUCKET=powstock-garden
